# ---- MySQL Database Configuration ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vectamind_db

# ---- Email / SMTP Configuration ----
# Required for account confirmation emails during user registration.
# For Gmail, generate an "App Password" in Google Account Security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER_NAME=AgriSense

# ---- Account Confirmation Base URL ----
# Points to Flask endpoint (database/confirm_server.py).
# Local testing: http://127.0.0.1:5000/confirm
# Mobile device testing: http://<YOUR_LAN_IP>:5000/confirm
CONFIRM_BASE_URL=http://127.0.0.1:5000/confirm
