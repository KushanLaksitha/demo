# ---- MySQL Database Configuration ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vectamind_db

# ---- Email / Brevo / SMTP Configuration ----
# Required for account confirmation emails during user registration.

# Option A: Brevo API Key (Recommended)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@domain.com

# Option B: Standard SMTP / Brevo SMTP Relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_key
SMTP_SENDER_NAME=AgriSense

# ---- Account Confirmation Base URL ----
# Points to Flask endpoint (database/confirm_server.py).
CONFIRM_BASE_URL=http://127.0.0.1:5000/confirm
